; num_nurse: 5
; num_doctor: 1
; num_patient: 3
; num_toolset: 2

(define
   (problem pfile6)
   (:domain medical)
   (:objects
      nurse_0 nurse_1 nurse_2 nurse_3 nurse_4 - nurse
      doctor_0 - doctor
      patient_0 patient_1 patient_2 - patient
      toolset_0 toolset_1 - toolset
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (operate patient_0))
         (task1 (operate patient_1))
         (task2 (operate patient_2))
      )
   )

   (:init
   )
)