; num_nurse: 5
; num_doctor: 4
; num_patient: 6
; num_toolset: 3

(define
   (problem pfile14)
   (:domain medical)
   (:objects
      nurse_0 nurse_1 nurse_2 nurse_3 nurse_4 - nurse
      doctor_0 doctor_1 doctor_2 doctor_3 - doctor
      patient_0 patient_1 patient_2 patient_3 patient_4 patient_5 - patient
      toolset_0 toolset_1 toolset_2 - toolset
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (operate patient_0))
         (task1 (operate patient_1))
         (task2 (operate patient_2))
         (task3 (operate patient_3))
         (task4 (operate patient_4))
         (task5 (operate patient_5))
      )
   )

   (:init
   )
)