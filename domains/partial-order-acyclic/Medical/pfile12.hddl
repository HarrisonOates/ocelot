; num_nurse: 4
; num_doctor: 1
; num_patient: 8
; num_toolset: 1

(define
   (problem pfile12)
   (:domain medical)
   (:objects
      nurse_0 nurse_1 nurse_2 nurse_3 - nurse
      doctor_0 - doctor
      patient_0 patient_1 patient_2 patient_3 patient_4 patient_5 patient_6 patient_7 - patient
      toolset_0 - toolset
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (operate patient_0))
         (task1 (operate patient_1))
         (task2 (operate patient_2))
         (task3 (operate patient_3))
         (task4 (operate patient_4))
         (task5 (operate patient_5))
         (task6 (operate patient_6))
         (task7 (operate patient_7))
      )
   )

   (:init
   )
)