; num_oven: 5
; num_brick: 2
; num_temp: 6

(define
   (problem pfile6)
   (:domain postman)
   (:objects
      oven_0 oven_1 oven_2 oven_3 oven_4 - oven
      brick_0 brick_1 - brick
      temp_0 temp_1 temp_2 temp_3 temp_4 temp_5 - temperature
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (dry brick_0))
         (task1 (dry brick_1))
      )
   )

   (:init
      (oven-cold oven_0)
      (oven-cold oven_1)
      (oven-cold oven_2)
      (oven-cold oven_3)
      (oven-cold oven_4)
      (brick-spec brick_0 temp_0)
      (brick-spec brick_1 temp_3)
   )
)