; num_postmen: 3
; num_mail: 16
; num_loc: 2

(define
   (problem pfile19)
   (:domain postman)
   (:objects
      postman_0 postman_1 postman_2 - postman
      mail_0 mail_1 mail_2 mail_3 mail_4 mail_5 mail_6 mail_7 mail_8 mail_9 mail_10 mail_11 mail_12 mail_13 mail_14 mail_15 - mail
      loc_0 loc_1 - location
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (deliver mail_0 loc_1))
         (task1 (deliver mail_1 loc_0))
         (task2 (deliver mail_2 loc_1))
         (task3 (deliver mail_3 loc_0))
         (task4 (deliver mail_4 loc_0))
         (task5 (deliver mail_5 loc_0))
         (task6 (deliver mail_6 loc_1))
         (task7 (deliver mail_7 loc_0))
         (task8 (deliver mail_8 loc_1))
         (task9 (deliver mail_9 loc_1))
         (task10 (deliver mail_10 loc_1))
         (task11 (deliver mail_11 loc_0))
         (task12 (deliver mail_12 loc_0))
         (task13 (deliver mail_13 loc_0))
         (task14 (deliver mail_14 loc_1))
         (task15 (deliver mail_15 loc_1))
      )
   )

   (:init
      (at postman_0 loc_0)
      (at postman_1 loc_0)
      (at postman_2 loc_1)
      (at mail_0 loc_1)
      (at mail_1 loc_1)
      (at mail_2 loc_1)
      (at mail_3 loc_0)
      (at mail_4 loc_1)
      (at mail_5 loc_1)
      (at mail_6 loc_1)
      (at mail_7 loc_1)
      (at mail_8 loc_1)
      (at mail_9 loc_1)
      (at mail_10 loc_0)
      (at mail_11 loc_1)
      (at mail_12 loc_0)
      (at mail_13 loc_0)
      (at mail_14 loc_0)
      (at mail_15 loc_1)
   )
)