; num_postmen: 4
; num_mail: 5
; num_loc: 4

(define
   (problem pfile8)
   (:domain postman)
   (:objects
      postman_0 postman_1 postman_2 postman_3 - postman
      mail_0 mail_1 mail_2 mail_3 mail_4 - mail
      loc_0 loc_1 loc_2 loc_3 - location
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (deliver mail_0 loc_2))
         (task1 (deliver mail_1 loc_1))
         (task2 (deliver mail_2 loc_1))
         (task3 (deliver mail_3 loc_0))
         (task4 (deliver mail_4 loc_1))
      )
   )

   (:init
      (at postman_0 loc_0)
      (at postman_1 loc_2)
      (at postman_2 loc_1)
      (at postman_3 loc_3)
      (at mail_0 loc_0)
      (at mail_1 loc_0)
      (at mail_2 loc_3)
      (at mail_3 loc_2)
      (at mail_4 loc_2)
   )
)