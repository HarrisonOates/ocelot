; num_postmen: 2
; num_mail: 6
; num_loc: 3

(define
   (problem pfile7)
   (:domain postman)
   (:objects
      postman_0, postman_1 - postman
      mail_0, mail_1, mail_2, mail_3, mail_4, mail_5 - mail
      loc_0, loc_1, loc_2 - location
   )

   (:htn
      :parameters ()
      :subtasks (and
         (task0 (deliver mail_0 loc_1))
         (task1 (deliver mail_1 loc_0))
         (task2 (deliver mail_2 loc_1))
         (task3 (deliver mail_3 loc_0))
         (task4 (deliver mail_4 loc_0))
         (task5 (deliver mail_5 loc_0))
      )
   )

   (:init
      (at postman_0 loc_2)
      (at postman_1 loc_0)
      (at mail_0 loc_0)
      (at mail_1 loc_2)
      (at mail_2 loc_2)
      (at mail_3 loc_2)
      (at mail_4 loc_1)
      (at mail_5 loc_0)
   )
)